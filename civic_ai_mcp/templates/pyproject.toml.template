[project]
name = "{{name}}-mcp"
version = "0.1.0"
description = "{{description}}"
readme = "README.md"
requires-python = ">=3.10"
authors = [{ name = "{{author}}" }]
license = { text = "MIT" }

dependencies = [
    "mcp>=1.0.0",
    "civic-ai-mcp-toolkit>=0.1.0",
]

[project.scripts]
{{name}}-mcp = "{{name}}_mcp.server:main"

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["."]
include = ["{{name}}_mcp*"]

[tool.setuptools.package-data]
"{{name}}_mcp" = ["data/*.json"]

[tool.ruff]
line-length = 100

[tool.pytest.ini_options]
testpaths = ["tests"]
